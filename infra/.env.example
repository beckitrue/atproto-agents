# ---- Domain -----------------------------------------------------------
DOMAIN=beckitrue.com

# ---- PDS (generate secrets with the commands shown) --------------------
# openssl rand --hex 16
PDS_ADMIN_PASSWORD=
# openssl rand --hex 16
PDS_JWT_SECRET=
# openssl ecparam --name secp256k1 --genkey --noout --outform DER | tail --bytes=+8 | head --bytes=32 | xxd --plain --cols 32
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=

# ---- Service auth (AT Proto; no IdP, no shared secret) -----------------
# The engine verifies agent tokens by resolving the issuer DID's signing key.
# ENGINE_DID is the audience agents mint for — the referee DID in agents.json.
# Defaults to the referee DID if unset.
ENGINE_DID=did:plc:xgdzu5egqclsjtiwiv7rkf2k
# Optional: point DID resolution at a self-contained dev PLC to keep local runs
# off the public plc.directory (see docs/HOW-TO-RUN-LOCALLY.md, which sets this).
# PLC_DIRECTORY_URL=http://plc:3000

# ---- OpenFGA (self-hosted; auto-populated by fga-init on first boot) ---
# Leave blank — docker compose up creates the store and fills these in via
# /fga-config/fga.env. Set explicitly here only if you need to pin specific IDs.
FGA_STORE_ID=
FGA_MODEL_ID=

# ---- Referee (SERVER-side — the engine's own AT Proto identity) ---------
# The engine publishes gameState records and the 🚨 DENIED mirrors as
# referee.$DOMAIN. Without this the engine still referees correctly but
# publishes NOTHING, and says so only in its startup log — so the audit
# trail disappears with no error. Same app password as the laptop's copy.
REFEREE_PDS_PASSWORD=

# ---- Agents (laptop-side, not needed on the server) ---------------------
# ANTHROPIC_API_KEY=
# GAME_ENGINE_URL=https://game.beckitrue.com
# PDS_URL=https://pds.beckitrue.com
# Per-agent PDS password (the agent logs in to mint service-auth tokens AND to
# post moves). Provisioned by scripts/set-agent-pds-passwords.mjs:
# RED_SPYMASTER_PDS_PASSWORD=
# (repeat for RED_OPERATIVE, BLUE_SPYMASTER, BLUE_OPERATIVE)
# Guest agent lives on a foreign PDS — NOT set by the script above, which only
# covers accounts we host. Make an app password in the Bluesky app (Settings →
# Privacy and Security → App Passwords) on the guest's own account and paste it
# here; that's the same thing docs/JOIN.md asks of every outside guest.
# GUEST_AGENT_PDS_PASSWORD=
# Login host for the guest. Leave unset — scripts default to the bsky.social
# entryway, which resolves accounts hosted anywhere on bsky.network.
# GUEST_PDS_URL=https://bsky.social
