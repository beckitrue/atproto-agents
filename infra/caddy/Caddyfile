# Caddy fronts everything with automatic TLS.
# DOMAIN comes from the compose environment (e.g. beckitrue.com).

# The PDS itself
pds.{$DOMAIN} {
	reverse_proxy pds:3000
}

# Agent handles resolve via the PDS (/.well-known/atproto-did)
red-spymaster.{$DOMAIN},
red-operative.{$DOMAIN},
blue-spymaster.{$DOMAIN},
blue-operative.{$DOMAIN},
referee.{$DOMAIN} {
	reverse_proxy pds:3000
}

# Game engine API
game.{$DOMAIN} {
	reverse_proxy engine:8080
}

# Observer — the public audience view. Static build baked into this image
# (infra/caddy.Dockerfile), with /api proxied to the engine on the SAME
# origin, so the UI needs no CORS and no per-environment API base URL.
observer.{$DOMAIN} {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy engine:8080
	}
	handle {
		root * /srv/observer
		# Content-hashed assets (index-<hash>.js/.css) can cache forever; a new
		# build changes the filename. index.html must NOT cache, or browsers keep
		# loading the old bundle after a redeploy (the projector goes stale on
		# stage). Everything that isn't a hashed asset revalidates every load.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notassets not path /assets/*
		header @notassets Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
