{
  "name": "@atproto-agents/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Codenames game engine — the authorization enforcement point. Verifies AT Proto service-auth tokens, checks FGA per move, maintains canonical game state, publishes state to AT Proto.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@atproto-agents/lexicon": "*",
    "@atproto/api": "^0.13.0",
    "@atproto/identity": "^0.5.6",
    "@atproto/xrpc-server": "^0.11.9",
    "@openfga/sdk": "^0.6.0",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "vitest": "^2.0.0"
  }
}
